# Copy to .env.local for local dev. Set the same names in Vercel > Project > Settings > Environment Variables.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
VITE_API_URL=https://YOUR-API.onrender.com
VITE_ALLOWED_DOMAIN=fiftyfivetech.io

# --- Server-only (set in Vercel env vars; NEVER prefix with VITE_, never commit) ---
# SUPABASE_SERVICE_ROLE_KEY=   used only by /api functions to apply one-tap approvals
# APPROVAL_SECRET=             long random string (openssl rand -hex 32); signs the approve links
# RESEND_API_KEY=              optional; emails the admin when someone requests access
# NOTIFY_FROM=FDE Tracker <no-reply@your-verified-domain>
# SITE_URL=https://your-app.vercel.app
